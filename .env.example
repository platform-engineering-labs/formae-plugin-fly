# Fly.io credentials for local development and conformance runs.
# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# The plugin resolves the token exactly as flyctl does: FLY_ACCESS_TOKEN first,
# FLY_API_TOKEN as the fallback. A token that works with `fly` works here.
# ~/.fly/config.yml is deliberately not read — the plugin runs inside the formae
# agent, often in a container with no $HOME/.fly.

# Personal access token (`fly auth token`) or, for CI, an org token
# (`fly tokens create org`). An app deploy token will NOT work: it is scoped to
# one existing app and cannot create apps.
FLY_ACCESS_TOKEN=

# The organization's real slug — not the "personal" alias. Fly accepts
# "personal" on create and reports the real slug on read, and since `org` is
# createOnly that is permanent drift. `fly orgs list` prints the slug.
FLY_ORG=

# Optional. Default region for machines and volumes that do not name one.
# FLY_REGION is deliberately not used: inside a Fly VM it means "the region I am
# running in", which would make applies depend on where the agent runs.
FLY_REGION_OVERRIDE=fra
