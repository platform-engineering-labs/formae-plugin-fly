//
// Conformance: update FLY::Apps::SecretKey.
//
// `value` is the only thing that can change in place. `keyType` is createOnly
// because changing the type of an existing key fails with
// `500 secret <name> is of type 3, expected 5` — see secretkey-replace.pkl.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.SecretKey {
    label = "plugin-sdk-test-secretkey"
    appName = app.res.name
    name = "sdk_test_key"
    keyType = "hs256"
    // Plain string, NOT formae.value(...).opaque, and only because this is a
    // conformance fixture: the agent hashes opaque values at rest, and the
    // harness compares the value declared here against what it reads back, so
    // an opaque value fails as `expected AAEC..., got 905f28de...`. Real usage
    // should wrap key material in `formae.value(x).opaque` — the README says so.
    value = "Hx4dHBsaGRgXFhUUExIREA8ODQwLCgkIBwYFBAMCAQA="
  }
}
