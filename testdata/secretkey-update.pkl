//
// Conformance: update FLY::Apps::SecretKey.
//
// `value` is the only thing that can change in place. `keyType` is createOnly
// because changing the type of an existing key fails with
// `500 secret <name> is of type 3, expected 5` — see secretkey-replace.pkl.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.SecretKey {
    label = "plugin-sdk-test-secretkey"
    appName = app.res.name
    name = "sdk_test_key"
    keyType = "hs256"
    // A plain string is fine — the field is typed opaque (its ValueSource arm
    // carries formae.SecretValue), so the agent hashes it at rest whatever form
    // it is written in, and conformance-tests v0.2.7 verifies the stored digest
    // against the plaintext declared here instead of comparing the two
    // literally. Wrapping it in formae.value(x).opaque would be redundant.
    value = "Hx4dHBsaGRgXFhUUExIREA8ODQwLCgkIBwYFBAMCAQA="
  }
}
