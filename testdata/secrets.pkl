//
// Conformance: create FLY::Apps::Secrets (with the app it hangs off).
//
// Free and fast — secrets are metadata, no compute involved. The app is created
// in the same forma rather than shared through an env var, so the test case
// carries its own prerequisites and destroy cleans up everything.
//
// `values` is write-only: the plugin never asks Fly to reveal secret values, so
// the harness's drift check sees only the app name. Adding and removing names is
// still detected, which is what the -update variant exercises.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.Secrets {
    label = "plugin-sdk-test-secrets"
    appName = app.res.name
    values {
      ["SDK_TEST_ONE"] = "value-one-\(v.testRunID)"
      ["SDK_TEST_TWO"] = "value-two-\(v.testRunID)"
    }
  }
}
