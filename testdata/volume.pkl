//
// Conformance: create FLY::Apps::Volume (with the app it hangs off).
//
// Costs a little: 1 GB of provisioned storage, prorated, for the length of the
// test. 1 GB is the minimum Fly accepts. No machine mounts it, so no compute is
// billed.
//
// The app is created in the same forma so a run that dies mid-test leaves
// exactly one thing to clean up — deleting the app cascades the volume.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.Volume {
    label = "plugin-sdk-test-volume"
    appName = app.res.name
    name = "sdk_test_vol"
    region = v.region
    sizeGb = 1
    fstype = "ext4"
  }
}
