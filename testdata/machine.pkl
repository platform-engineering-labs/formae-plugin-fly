//
// Conformance: create FLY::Apps::Machine (with the app it hangs off).
//
// BILLABLE. A Fly machine bills by the second while it runs. This uses the
// cheapest guest Fly offers (shared-cpu-1x, 256 MB) and the machine is destroyed
// in the same test, so a run costs cents — but a run that dies between create
// and destroy leaves it running. clean-environment.sh deletes the whole app,
// which cascades the machine.
//
// Create is async: the API answers with state "created", then the machine pulls
// its image and boots. Status() polls until `started`. Give the harness room:
//
//   make conformance-test TEST=machine TIMEOUT=15
//
// No `services` block on purpose. A service would make the machine a routing
// target, and without an allocated IP that is pointless; leaving it out also
// keeps fly-proxy's autostop out of the picture, so `state` is stable for the
// duration of the test.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.Machine {
    label = "plugin-sdk-test-machine"
    appName = app.res.name
    name = "sdk-test-machine"
    region = v.region
    image = v.image
    guest = v.guest
    env {
      ["SDK_TEST_RUN"] = v.testRunID
    }
    metadata {
      ["managed-by"] = "formae-conformance"
    }
  }
}
