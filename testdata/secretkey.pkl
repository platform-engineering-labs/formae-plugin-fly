//
// Conformance: create FLY::Apps::SecretKey (with the app it hangs off).
//
// Free — key material is metadata, no compute involved.
//
// This case supplies explicit material so the update path has something it can
// legitimately change. Omitting `value` is the *recommended* usage — Fly then
// generates the key and the material never exists outside Fly — and that branch
// is covered by unit tests instead, because a generated key has no field a forma
// can change and so no update to exercise.
//
// The name uses underscores: hyphens are rejected with
// `400 "<name>" is not a valid secret name`.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.SecretKey {
    label = "plugin-sdk-test-secretkey"
    appName = app.res.name
    name = "sdk_test_key"
    keyType = "hs256"
    // Plain string, NOT formae.value(...).opaque, and only because this is a
    // conformance fixture: the agent hashes opaque values at rest, and the
    // harness compares the value declared here against what it reads back, so
    // an opaque value fails as `expected AAEC..., got 905f28de...`. Real usage
    // should wrap key material in `formae.value(x).opaque` — the README says so.
    value = "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
  }
}
