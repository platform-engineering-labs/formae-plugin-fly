//
// Conformance: replace FLY::Apps::SecretKey.
//
// `name` is the replace trigger, not `keyType`. Both are createOnly, but only
// `name` is part of the native id (`{app}/{name}`) — and the harness asserts the
// native id changes across a replacement, so a keyType-only change looks to it
// like nothing happened.
//
// keyType is createOnly for its own reason: posting a new type to an existing
// key answers `500 secret <name> is of type 3, expected 5`, so formae has to
// replace rather than update. That path is covered by unit tests; this fixture
// exercises the harness-visible replacement.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.SecretKey {
    label = "plugin-sdk-test-secretkey"
    appName = app.res.name
    name = "sdk_test_key_replaced"   // CHANGED — createOnly, and part of the native id
    keyType = "hs256"
    // Plain string rather than formae.value(...).opaque: the agent hashes
    // opaque values at rest and the harness compares against what is declared
    // here, so an opaque value fails as `expected AAEC..., got 905f28de...`.
    // Real usage should wrap key material in `formae.value(x).opaque`.
    value = "Hx4dHBsaGRgXFhUUExIREA8ODQwLCgkIBwYFBAMCAQA="
  }
}
