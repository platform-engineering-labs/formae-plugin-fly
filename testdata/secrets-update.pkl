//
// Conformance: update FLY::Apps::Secrets.
//
// Exercises all three things an update can do to the bag at once: change a
// value (SDK_TEST_ONE), drop a name (SDK_TEST_TWO), add a name
// (SDK_TEST_THREE). Fly has no bulk delete, so the dropped name is one DELETE
// followed by a single bulk POST of what survives.

amends "@formae/forma.pkl"
import "@fly/core/fly.pkl"

import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  local app = v.app
  app

  new fly.Secrets {
    label = "plugin-sdk-test-secrets"
    appName = app.res.name
    values {
      ["SDK_TEST_ONE"] = "value-one-updated-\(v.testRunID)"   // CHANGED
      ["SDK_TEST_THREE"] = "value-three-\(v.testRunID)"       // ADDED
      // SDK_TEST_TWO removed
    }
  }
}
