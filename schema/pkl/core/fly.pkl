/// Fly.io resource definitions.
///
/// Every type here maps to the Fly.io Machines REST API
/// (https://api.machines.dev, OpenAPI at https://docs.machines.dev/spec/openapi3.json).
/// Only resources the plugin actually implements appear in this module — see
/// docs/RESOURCES.md for the full catalog and what is coming next.
module fly

import "@formae/formae.pkl"

// =============================================================================
// Target configuration
// =============================================================================

/// Deployment-level config for a Fly.io target.
///
/// Credentials are NEVER in here. The plugin reads the API token from
/// FLY_ACCESS_TOKEN, falling back to FLY_API_TOKEN — flyctl's own precedence,
/// so a token that works with `fly` works here.
open class Config {
    hidden fixed type: String = "FLY"

    /// Fly organization slug — the real one, not the "personal" alias
    /// (see FLY::Apps::App.org). Required: listing apps
    /// (GET /v1/apps?org_slug=) and org-wide machine/volume discovery
    /// (GET /v1/orgs/{slug}/machines) both need it, and it cannot be derived
    /// from a token.
    org: String

    /// Default Fly region code for Machines and Volumes that do not name one
    /// (e.g. "fra", "iad", "ams"). The authoritative list is public and needs
    /// no auth: GET https://api.machines.dev/v1/platform/regions
    region: String?

    /// Override the API endpoint. Defaults to https://api.machines.dev.
    /// From inside a Fly WireGuard network, http://_api.internal:4280 works.
    baseUrl: String?

    fixed Type: String = type
    fixed Org: String = org
    fixed Region: String? = region
    fixed BaseUrl: String? = baseUrl
}

// =============================================================================
// FLY::Apps::App
// =============================================================================

/// Resolvable handle for `FLY::Apps::App` outputs. Reference these from child
/// resources to wire a freshly created app into its machines, secrets, volumes,
/// certificates and IPs in the same apply, e.g.
///   appName = api.res.name
open class AppResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::App"

    hidden id:   AppResolvable = (this) { property = "id" }
    hidden name: AppResolvable = (this) { property = "name" }
}

/// A Fly.io app — the namespace every other Fly resource lives in.
/// Maps to POST /v1/apps.
///
/// An app on its own costs nothing; billing starts when a Machine runs inside
/// it. There is no app-update endpoint, so every field is createOnly: changing
/// one replaces the app (and everything in it).
@formae.ResourceHint {
    type = "FLY::Apps::App"
    identifier = "$.name"
    discoverable = true
}
class App extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::App"

    local parent = this
    hidden res: AppResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App name. Globally unique across all of Fly.io — a collision fails the
    /// create with HTTP 422 rather than binding to someone else's app.
    /// This is also the native id.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    name: String

    /// The organization's real slug — NOT the "personal" alias.
    ///
    /// Fly accepts `personal` on create and reports the real slug on read.
    /// Since this field is createOnly, that mismatch is drift on an immutable
    /// field and formae would replace the app on every reconcile. The plugin
    /// refuses "personal" at create and names the slug to use instead.
    ///
    /// Required on the resource even though the target also carries an `org`:
    /// the target's value scopes discovery and listing, this one decides where
    /// the app is created. Being explicit here means an omitted value can never
    /// be read back from the API as drift.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    org: String

    /// 6PN private network name. Apps in the same network can reach each other
    /// over .internal DNS. Defaults to the app's own name server-side.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    network: String?

    /// Whether to enable *.fly.dev subdomain routing for this app.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    enableSubdomains: Boolean?

    /// Fly's internal app id. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// App status as reported by Fly ("pending", "deployed", "suspended").
    /// Output only.
    @formae.FieldHint { hasProviderDefault = true }
    status: String?
}

// =============================================================================
// FLY::Apps::Machine
// =============================================================================

/// Guest sizing. `shared-cpu-1x` with 256 MB is `cpuKind = "shared"`,
/// `cpus = 1`, `memoryMb = 256` — the cheapest thing Fly runs.
class MachineGuest {
    /// "shared" or "performance".
    cpuKind: String? = "shared"
    /// vCPU count.
    cpus: Int? = 1
    /// Memory in MB. Must be a multiple of 256.
    memoryMb: Int? = 256
}

/// A published port on a service.
class MachinePort {
    /// External port fly-proxy listens on.
    port: Int
    /// Connection handlers, in order: "http", "tls", "proxy_proto".
    handlers: Listing<String>?
    /// Redirect plain HTTP to HTTPS.
    forceHttps: Boolean?
}

/// A service fly-proxy routes to. Without at least one service (and an
/// allocated IP address) an app is not reachable from the internet.
class MachineService {
    /// Port inside the machine that the process listens on.
    internalPort: Int
    /// "tcp" or "udp".
    protocol: String? = "tcp"
    /// Published ports.
    ports: Listing<MachinePort>?
    /// Start the machine on an incoming request when it is stopped.
    autostart: Boolean?
    /// "off", "stop" or "suspend". Fly stops idle machines when set — see the
    /// note on `state` below for why the plugin does not fight that.
    autostop: String?
    /// Keep at least this many machines running regardless of traffic.
    minMachinesRunning: Int?
}

/// A volume mounted into the machine's filesystem.
class MachineMount {
    /// Volume id (`vol_...`) or, when using `name`, left unset.
    volume: String?
    /// Mount point inside the machine. The EntitySet index — see the FieldHint
    /// on `mounts`.
    path: String
    /// Volume name, as an alternative to a specific volume id.
    name: String?
}

/// What flyd does when the machine's main process exits.
class MachineRestart {
    /// "no", "always", "on-failure" or "spot-price".
    policy: String?
    /// Cap on restart attempts when policy is "on-failure".
    maxRetries: Int?
}

/// Resolvable handle for `FLY::Apps::Machine` outputs.
open class MachineResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::Machine"

    hidden id:        MachineResolvable = (this) { property = "id" }
    hidden privateIp: MachineResolvable = (this) { property = "privateIp" }
    hidden state:     MachineResolvable = (this) { property = "state" }
}

/// A Fly Machine — one Firecracker VM running one container image.
/// Maps to POST /v1/apps/{app}/machines.
///
/// Machines bill by the second while they run. Create is async: the API
/// answers with `state = "created"` and the machine then pulls its image and
/// boots, so Create returns InProgress and formae polls Status() until the
/// machine reaches `started`.
///
/// Native id is `{appName}/{machineId}` — machine ids are only unique within
/// an app.
@formae.ResourceHint {
    type = "FLY::Apps::Machine"
    identifier = "$.id"
    discoverable = true
}
class Machine extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::Machine"

    local parent = this
    hidden res: MachineResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App that owns this machine. Immutable — a machine cannot move between
    /// apps.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    appName: String|formae.Resolvable

    /// Machine name. Fly generates one when omitted.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    name: String?

    /// Fly region code. Immutable: a machine is pinned to the host its rootfs
    /// lives on, and there is no move operation. Changing it replaces the
    /// machine. Falls back to the target's `region` when unset.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    region: String?

    /// Docker image to run, e.g. "flyio/hellofly:latest" or a registry.fly.io
    /// reference.
    @formae.FieldHint { requiredOnCreate = true }
    image: String

    /// Environment variables baked into the machine config. These are visible
    /// in state and in `fly machine status` — put anything sensitive in
    /// `FLY::Apps::Secrets` instead, which the platform injects at boot.
    ///
    /// An entry may be a `formae.Resolvable`, so a non-secret identifier from
    /// another resource (or another plugin) can be wired in directly:
    ///   ["SUPABASE_PROJECT_REF"] = db.res.id
    /// formae orders the graph from that reference and substitutes the value at
    /// apply time. A resolvable is a handle, not a string: pass it as a whole
    /// value, never interpolated into one.
    @formae.FieldHint {}
    env: Mapping<String, (String|formae.Resolvable)>?

    /// CPU and memory sizing.
    @formae.FieldHint { hasProviderDefault = true }
    guest: MachineGuest?

    /// Services fly-proxy routes to.
    @formae.FieldHint {}
    services: Listing<MachineService>?

    /// Volume mounts, keyed by mount path. EntitySet semantics: items are
    /// matched by `path` across updates, so reordering the listing is not a
    /// change and editing one mount does not rewrite the others.
    @formae.FieldHint {
        updateMethod = "EntitySet"
        indexField = "path"
    }
    mounts: Listing<MachineMount>?

    /// Restart policy.
    @formae.FieldHint { hasProviderDefault = true }
    restart: MachineRestart?

    /// Arbitrary key/value metadata on the machine.
    @formae.FieldHint {}
    metadata: Mapping<String, String>?

    /// Override the image's entrypoint.
    @formae.FieldHint {}
    entrypoint: Listing<String>?

    /// Override the image's command.
    @formae.FieldHint {}
    cmd: Listing<String>?

    /// Destroy the machine once its main process exits. For one-shot jobs.
    @formae.FieldHint { hasProviderDefault = true }
    autoDestroy: Boolean?

    /// Machine id, e.g. "17811943c9d489". Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// Current lifecycle state: "created", "starting", "started", "stopping",
    /// "stopped", "suspended", "replacing", "destroying", "destroyed".
    ///
    /// Output only, and deliberately NOT reconciled: setting it does nothing.
    /// Fly's own proxy stops and starts machines as normal operation when
    /// `services[].autostop`/`autostart` are set, so treating this field as
    /// desired state would read an autostopped machine as drift, start it, get
    /// it autostopped again — an infinite reconcile loop that also bills for
    /// every wake-up. Use `fly machine start|stop` for runtime control. See
    /// docs/ARCHITECTURE.md.
    @formae.FieldHint { hasProviderDefault = true }
    state: String?

    /// The machine's 6PN private IPv6 address, reachable from other machines
    /// in the same organization. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    privateIp: String?
}

// =============================================================================
// FLY::Apps::Volume
// =============================================================================

/// Resolvable handle for `FLY::Apps::Volume` outputs.
open class VolumeResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::Volume"

    hidden id:   VolumeResolvable = (this) { property = "id" }
    hidden name: VolumeResolvable = (this) { property = "name" }
}

/// A persistent volume attached to at most one Machine.
/// Maps to POST /v1/apps/{app}/volumes.
///
/// Native id is `{appName}/{volumeId}`.
///
/// `region` is createOnly and there is no move operation: a volume is physical
/// storage on one host. Changing the region replaces the volume, which means
/// the data is gone. That is the honest model; silently ignoring the change
/// would be worse.
@formae.ResourceHint {
    type = "FLY::Apps::Volume"
    identifier = "$.id"
    discoverable = true
}
class Volume extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::Volume"

    local parent = this
    hidden res: VolumeResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App that owns this volume. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    appName: String|formae.Resolvable

    /// Volume name. Machines mount by name or by id. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    name: String

    /// Fly region code. Immutable — see the class comment. Falls back to the
    /// target's `region` when unset.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    region: String?

    /// Size in GB. Can grow (PUT .../extend) but never shrink; a smaller value
    /// is rejected rather than silently ignored.
    @formae.FieldHint { hasProviderDefault = true }
    sizeGb: Int? = 1

    /// Encrypt the volume at rest. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    encrypted: Boolean?

    /// Filesystem to format with, e.g. "ext4". Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    fstype: String?

    /// Place this volume in a different hardware zone from the app's others.
    /// Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    requireUniqueZone: Boolean?

    /// Take scheduled automatic snapshots. Fly defaults this to true.
    @formae.FieldHint { hasProviderDefault = true }
    autoBackupEnabled: Boolean?

    /// Days to keep automatic snapshots.
    @formae.FieldHint { hasProviderDefault = true }
    snapshotRetention: Int?

    /// Volume id, e.g. "vol_9x1kj4rz". Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// Volume state as reported by Fly. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    state: String?

    /// Hardware zone the volume landed in. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    zone: String?

    /// Machine currently mounting this volume, if any. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    attachedMachineId: String?
}

// =============================================================================
// FLY::Apps::Secrets
// =============================================================================

/// Resolvable handle for `FLY::Apps::Secrets` outputs. Reference it to force a
/// Machine to be created after its secrets exist.
open class SecretsResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::Secrets"

    hidden appName: SecretsResolvable = (this) { property = "appName" }
}

/// All of an app's secrets, as one resource.
///
/// The Fly secrets endpoint is a bulk bag per app (POST /v1/apps/{app}/secrets
/// with `{"values": {...}}`). Modelling the whole bag as one resource makes
/// every mutation a single atomic call, which avoids the lost-update race that
/// per-secret resources hit when applied concurrently — each concurrent
/// single-item write is a read-modify-write on the shared bag, and the last
/// writer wins.
///
/// Native id is `{appName}/secrets`, not the bare app name: formae keys
/// inventory by (target, nativeID) regardless of resource type, so a bare app
/// name would make the bag a duplicate of its own App and one of them would be
/// deleted.
///
/// Secrets are injected into a machine's environment at boot. **A running
/// machine does not pick up a changed secret until it restarts** — the plugin
/// does not restart machines for you, because a service interruption should
/// not be an invisible side effect of a secret update.
// Not extractable. `values` is write-only and the plugin never asks Fly to
// reveal it, so an extracted Secrets bag would carry an appName and no values —
// and Create rejects a bag with no values, so the extracted forma could not be
// applied. Still discoverable: knowing the bag exists is useful even though its
// contents cannot be reconstructed. Same reasoning as the AWS plugin applies to
// resources whose create-only fields a Read can never populate.
@formae.ResourceHint {
    type = "FLY::Apps::Secrets"
    identifier = "$.appName"
    discoverable = true
    extractable = false
}
class Secrets extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::Secrets"

    local parent = this
    hidden res: SecretsResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App that owns the bag. Immutable. One Secrets resource per app.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    appName: String|formae.Resolvable

    /// Secret name → value.
    ///
    /// Write-only: the plugin never asks Fly to reveal values (the API can, via
    /// `?show_secrets=true`, and deliberately is not used), so a changed value
    /// cannot be detected as drift — only an added or removed *name* can.
    /// Nullable on purpose: the schema extractor marks every non-nullable,
    /// no-default field `Required`, and discovery rejects a resource whose
    /// Required fields are absent from the Read response. Since Read never
    /// returns values, a non-nullable `values` would make every existing
    /// secret bag undiscoverable. Create() enforces presence in Go instead.
    ///
    /// Opacity is per entry, not per field: write a sensitive value as
    /// `formae.value(x).opaque` and the agent hashes it at rest.
    ///
    /// A field-level `opaque = true` hint would be pointless here — formae's
    /// schema extractor computes it as `opaque = isSecretValueType(fieldType)`,
    /// overwriting whatever the author set, and that check does not look inside
    /// a Mapping's value type. So on formae 0.89.0 a map-valued field cannot be
    /// marked opaque as a whole. Verified against the rendered schema Hints.
    /// `writeOnly` still applies and keeps the field out of drift detection.
    ///
    /// An entry is anything formae can supply — `formae.ValueSource` — which is
    /// what makes cross-plugin wiring work. A credential produced by another
    /// resource in the same apply goes straight in:
    ///   ["SUPABASE_PROJECT_REF"] = db.res.id
    /// A secret held by another provider is read live on every plugin call, so
    /// rotating it upstream needs no re-apply here:
    ///   ["DB_PASSWORD"] = dbSecret.res.secretValue
    ///   ["API_KEY"]     = vaultSecret.res.secretValue.at("api-key")
    /// And a generator binding lets formae draw the credential itself, once or
    /// on a rotation cadence, moving this bag and everything else bound to it
    /// together:
    ///   ["SESSION_SECRET"] = sessionPw.gen.value
    /// formae orders the graph from the reference and substitutes the value at
    /// apply time, so the credential never appears in this forma. A reference
    /// is a handle, not a string — pass it whole, never interpolated.
    @formae.FieldHint { writeOnly = true }
    values: Mapping<String, (String|formae.ValueSource)>?
}

// =============================================================================
// FLY::Apps::Certificate
// =============================================================================

/// DNS records the user must publish for Fly to validate a custom hostname.
/// Output only, populated from the API's `dns_requirements`.
class CertificateDNSRequirements {
    /// CNAME target to point the hostname at.
    cname: String?
    /// A records to publish, when using apex records instead of a CNAME.
    a: Listing<String>?
    /// AAAA records to publish.
    aaaa: Listing<String>?
    /// Name of the ownership-verification TXT record.
    ownershipName: String?
    /// Value of the ownership-verification TXT record for this app.
    ownershipValue: String?
    /// ACME challenge record name.
    acmeChallengeName: String?
    /// ACME challenge record target.
    acmeChallengeTarget: String?
}

/// Resolvable handle for `FLY::Apps::Certificate` outputs.
open class CertificateResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::Certificate"

    hidden hostname: CertificateResolvable = (this) { property = "hostname" }
    hidden status:   CertificateResolvable = (this) { property = "status" }
}

/// An ACME certificate request for a custom hostname on an app.
/// Maps to POST /v1/apps/{app}/certificates/acme.
///
/// Native id is `{appName}/{hostname}` — the hostname is the server-side key.
///
/// Create returns Success as soon as Fly accepts the *request*, not when the
/// certificate is valid. Validation waits on DNS records only the user can
/// publish, so `status` can legitimately sit at `pending_validation` forever;
/// returning InProgress would hang the apply on an action formae cannot take.
/// Publish the records in `dnsRequirements`, then
/// `POST .../certificates/{hostname}/check` (or `fly certs check`) to trigger
/// re-validation.
@formae.ResourceHint {
    type = "FLY::Apps::Certificate"
    identifier = "$.hostname"
    discoverable = true
}
class Certificate extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::Certificate"

    local parent = this
    hidden res: CertificateResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App the certificate belongs to. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    appName: String|formae.Resolvable

    /// Hostname to certify, e.g. "api.example.com". Immutable — it is the
    /// resource's identity server-side, so a change replaces the certificate.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    hostname: String

    /// Validation status: "pending_ownership", "pending_validation", "active".
    /// Output only.
    @formae.FieldHint { hasProviderDefault = true }
    status: String?

    /// Whether Fly considers the hostname's DNS correctly configured.
    /// Output only.
    @formae.FieldHint { hasProviderDefault = true }
    configured: Boolean?

    /// The DNS records to publish. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    dnsRequirements: CertificateDNSRequirements?
}

// =============================================================================
// FLY::Apps::IPAddress
// =============================================================================

/// Resolvable handle for `FLY::Apps::IPAddress` outputs.
open class IPAddressResolvable extends formae.Resolvable {
    hidden type = "FLY::Apps::IPAddress"

    hidden ip: IPAddressResolvable = (this) { property = "ip" }
}

/// An IP address assigned to an app. Maps to
/// POST /v1/apps/{app}/ip_assignments.
///
/// Native id is `{appName}/{ip}`. The address itself is chosen by Fly, so
/// every input field is createOnly and there is no update path.
///
/// An app with Machines and services is still unreachable from the internet
/// until it has an IP assigned — `fly deploy` does this implicitly, the raw
/// Machines API does not. `shared_v4` and `v6` are free; a dedicated `v4` is
/// billable.
@formae.ResourceHint {
    type = "FLY::Apps::IPAddress"
    identifier = "$.ip"
    discoverable = true
}
class IPAddress extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::IPAddress"

    local parent = this
    hidden res: IPAddressResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// App to assign the address to. Immutable.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    appName: String|formae.Resolvable

    /// Address type: "shared_v4" (free), "v4" (dedicated, billable) or
    /// "v6" (free). Immutable.
    ///
    /// The API accepts "private_v6" too, and this plugin can create one, but it
    /// is deliberately not listed as supported: the assignment listing reports
    /// only the address and whether it is shared, never the type that was
    /// requested, so Read has to infer the type from the address family. A
    /// private 6PN address is IPv6 and would read back as "v6" — permanent
    /// drift that formae would try to fix by replacing the resource, forever.
    /// The three types above all round-trip correctly.
    @formae.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    addressType: String

    /// Region for a regional address. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    region: String?

    /// 6PN network name, for private addresses. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    network: String?

    /// Bind the address to a named service rather than the whole app.
    /// Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    serviceName: String?

    /// The allocated address. Output only — Fly picks it.
    @formae.FieldHint { hasProviderDefault = true }
    ip: String?

    /// Whether the address is shared with other apps. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    shared: Boolean?
}

// =============================================================================
// FLY::Apps::VolumeSnapshot
// =============================================================================

/// A point-in-time snapshot of a Volume.
/// Maps to POST /v1/apps/{app}/volumes/{volume}/snapshots.
///
/// Native id is `{appName}/{volumeId}/{id}`.
///
/// READ THIS FIRST. Fly exposes no delete endpoint for snapshots, so
/// `formae destroy` reports success and the snapshot stays until it ages out
/// under the volume's `snapshotRetention`. The id is server-assigned, so
/// re-applying after a destroy takes a *new* snapshot rather than reconciling
/// to the existing one. Volumes already snapshot themselves on a schedule when
/// `autoBackupEnabled` is set — use this resource for an explicit snapshot at
/// apply time (before a migration, say), not as a backup schedule.
// Not extractable. The snapshot id is server-assigned and a forma cannot name
// one, so applying an extracted snapshot takes a NEW snapshot rather than
// adopting the existing one — the extract does not round-trip.
@formae.ResourceHint {
    type = "FLY::Apps::VolumeSnapshot"
    identifier = "$.id"
    discoverable = true
    extractable = false
}
class VolumeSnapshot extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::VolumeSnapshot"

    /// App owning the volume. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    appName: String|formae.Resolvable

    /// Volume to snapshot. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    volumeId: String|formae.Resolvable

    /// Snapshot id, assigned by Fly. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// Snapshot status. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    status: String?

    /// Size in bytes. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    size: Int?

    /// Content digest. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    digest: String?

    /// RFC 3339 creation timestamp. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    createdAt: String?
}

// =============================================================================
// FLY::Apps::SecretKey
// =============================================================================

/// App-scoped KMS key material backing Fly's encrypt / decrypt / sign / verify
/// endpoints. Maps to POST /v1/apps/{app}/secretkeys/{name}.
///
/// This is NOT an environment-variable secret — that is `FLY::Apps::Secrets`.
/// The crypto operations themselves are runtime verbs and are not modelled.
///
/// Native id is `{appName}/{name}`.
@formae.ResourceHint {
    type = "FLY::Apps::SecretKey"
    identifier = "$.name"
    discoverable = true
}
class SecretKey extends formae.Resource {
    fixed hidden type: String = "FLY::Apps::SecretKey"

    /// App that owns the key. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    appName: String|formae.Resolvable

    /// Key name. Immutable — it is the key's identity server-side.
    ///
    /// Hyphens are rejected: the API answers
    /// `400 "<name>" is not a valid secret name`. Use underscores.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    name: String

    /// Key type. REQUIRED — omitting it is a 400, despite the OpenAPI spec
    /// listing the field as optional. The API reports the accepted set in its
    /// error message:
    ///
    ///   hs256, hs384, hs512, xaes256gcm, nacl_auth, nacl_box,
    ///   nacl_secretbox, nacl_sign, es256
    ///
    /// Immutable. POST on the key is create-or-update, but only for the
    /// *material*: changing the type of an existing key fails with
    /// `500 secret <name> is of type 3, expected 5`. Re-posting the same type
    /// rotates the material and succeeds. So a type change must replace the
    /// resource, which is what createOnly makes formae do — and it keeps
    /// formae from retrying that 500 as a recoverable error.
    /// Verified against api.machines.dev, 2026-09-04.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    keyType: String

    /// Base64-encoded key material. Write-only — the API never returns it.
    ///
    /// Omit it and Fly generates the key, which is the safer default and what
    /// most callers want; supplying it means the material exists somewhere
    /// outside Fly.
    ///
    /// The `formae.ValueSource` arm carries `formae.SecretValue`, which is what
    /// makes the field opaque in its rendered FieldHint: the agent hashes the
    /// value at rest whatever form the author supplied it in, so a bare string
    /// literal is as safe here as `formae.value(x).opaque` and the explicit
    /// `.opaque` is now redundant. The same arm accepts a secret held by
    /// another provider,
    ///   value = vaultSecret.res.secretValue
    /// read live on every plugin call, so rotating it upstream needs no
    /// re-apply here.
    ///
    /// A generator binding (`pw.gen.value`, `keys.gen.privateKey`) type-checks
    /// too, but read the encoding first: Fly wants base64 of raw key material
    /// sized for `keyType`, and neither generator emits that — PasswordGenerator
    /// draws a plain random string and KeyPairGenerator a PEM. Supplying either
    /// unmodified answers 400. Omitting `value` and letting Fly generate the
    /// key remains the right default.
    @formae.FieldHint { writeOnly = true }
    value: (String|formae.ValueSource)?

    /// Base64 public key, present only for asymmetric types (nacl_box, nacl_sign,
    /// es256). Output only. The spec declares this an array of integers; the API
    /// returns a base64 string.
    @formae.FieldHint { hasProviderDefault = true }
    publicKey: String?

    /// RFC 3339 creation timestamp. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    createdAt: String?
}

// =============================================================================
// FLY::Postgres::Cluster
// =============================================================================

/// A connection endpoint on a Managed Postgres cluster. Output only.
class PostgresEndpoint {
    host: String?
    port: Int?
}

/// Resolvable handle for `FLY::Postgres::Cluster` outputs. Reference these to
/// wire a freshly created cluster into its databases, users and attachments in
/// the same apply, e.g. `clusterId = db.res.id`.
open class ClusterResolvable extends formae.Resolvable {
    hidden type = "FLY::Postgres::Cluster"

    hidden id:   ClusterResolvable = (this) { property = "id" }
    hidden name: ClusterResolvable = (this) { property = "name" }
}

/// A Fly.io Managed Postgres cluster. Maps to POST /v1/postgres.
///
/// Org-scoped, not app-scoped: the native id is the bare cluster id.
///
/// Create is async and slow — the status walk is
/// `creating → initializing → ready`, and `primaryEndpoint` is only populated
/// once the cluster is ready, so anything needing a connection host must wait.
/// `formae apply` returns as soon as the agent accepts the command; poll with
/// `formae command status <id> --output-layout detailed` to watch it converge.
///
/// COSTS MONEY: a cluster is a real, always-on database. There is no free tier.
@formae.ResourceHint {
    type = "FLY::Postgres::Cluster"
    identifier = "$.id"
    discoverable = true
}
class Cluster extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::Cluster"

    local parent = this
    hidden res: ClusterResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Cluster name. Fly generates one when omitted. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    name: String?

    /// Organization slug that owns the cluster — the real slug, not the
    /// "personal" alias. Falls back to the target's `org`. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    org: String?

    /// Fly region for the primary node. Immutable. Required.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    region: String

    /// Plan slug selecting CPU, memory and disk: "basic", "starter", "launch",
    /// "scale" or "Performance". The capital P on the last one is Fly's, not a
    /// typo here. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    plan: String

    /// Disk size in GB, 10–1000. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    diskSizeGb: Int?

    /// Postgres major version: "16" or "17". Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    pgMajorVersion: String?

    /// Connection pooler mode: "session" or "transaction".
    ///
    /// Write-only: the API accepts it on create and never reports it back, so
    /// reading it would mean inventing a value and diffing it would mean
    /// permanent drift.
    @formae.FieldHint { createOnly = true; writeOnly = true }
    poolMode: String?

    /// Enable PostGIS support. Required before PostGIS extensions can be
    /// enabled. Immutable.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    postgisEnabled: Boolean?

    /// Cluster id. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// Lifecycle status: "creating", "initializing", "ready", "deleting",
    /// "deleted", "failed". Output only.
    @formae.FieldHint { hasProviderDefault = true }
    status: String?

    /// CPU class the plan resolved to. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    cpuKind: String?

    /// vCPUs per node. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    cpus: Int?

    /// Memory per node in MB. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    memoryMb: Int?

    /// Replica count. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    replicas: Int?

    /// Direct (unpooled) primary endpoint. Populated once ready. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    primaryEndpoint: PostgresEndpoint?

    /// Pooled primary endpoint, through PgBouncer. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    poolerEndpoint: PostgresEndpoint?
}

// =============================================================================
// FLY::Postgres::Database
// =============================================================================

/// Resolvable handle for `FLY::Postgres::Database` outputs. An Extension must
/// reference its database through this rather than naming it as a string —
/// otherwise formae only knows the extension depends on the *cluster*, and can
/// try to enable it before the database exists.
open class DatabaseResolvable extends formae.Resolvable {
    hidden type = "FLY::Postgres::Database"

    hidden name: DatabaseResolvable = (this) { property = "name" }
}

/// A database inside a Managed Postgres cluster.
/// Native id is `{clusterId}/{name}`.
@formae.ResourceHint {
    type = "FLY::Postgres::Database"
    identifier = "$.name"
    discoverable = true
}
class Database extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::Database"

    local parent = this
    hidden res: DatabaseResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }

    /// Cluster that holds the database. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    clusterId: String|formae.Resolvable

    /// Database name. Immutable — the API offers no rename.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    name: String
}

// =============================================================================
// FLY::Postgres::User
// =============================================================================

/// A role inside a Managed Postgres cluster.
/// Native id is `{clusterId}/{username}`.
///
/// The generated password is deliberately not exposed. Create does not return
/// it, and the plugin does not call the endpoint that would reveal it: pulling
/// a live database password into formae's state to fill an output field is a
/// worse trade than fetching it with `fly mpg` when you need it.
@formae.ResourceHint {
    type = "FLY::Postgres::User"
    identifier = "$.username"
    discoverable = true
}
class User extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::User"

    /// Cluster that holds the user. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    clusterId: String|formae.Resolvable

    /// User name. Immutable — it is the user's identity.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    username: String

    /// Role: "schema_admin", "writer" or "reader". The one mutable field.
    @formae.FieldHint { requiredOnCreate = true }
    role: String
}

// =============================================================================
// FLY::Postgres::Attachment
// =============================================================================

/// Attaches a Fly app to a Managed Postgres cluster.
/// Native id is `{clusterId}/{appName}`.
///
/// Attaching provisions a database and a user for the app and injects a
/// DATABASE_URL secret into it. That secret is created by Fly, not by this
/// plugin — do not also declare it in a `FLY::Apps::Secrets` bag, or the two
/// will fight over the same key.
@formae.ResourceHint {
    type = "FLY::Postgres::Attachment"
    identifier = "$.appName"
    discoverable = true
}
class Attachment extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::Attachment"

    /// Cluster to attach to. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    clusterId: String|formae.Resolvable

    /// App to attach. Immutable. Both ends are the attachment's identity.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    appName: String|formae.Resolvable
}

// =============================================================================
// FLY::Postgres::Extension
// =============================================================================

/// A Postgres extension enabled in one database.
/// Native id is `{clusterId}/{databaseName}/{name}`.
///
/// The API's list endpoint returns every extension the cluster *offers*, each
/// with an `installed` object that is null when it is not enabled — so
/// "exists" here means installed, not merely listed.
@formae.ResourceHint {
    type = "FLY::Postgres::Extension"
    identifier = "$.name"
    discoverable = true
}
class Extension extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::Extension"

    /// Cluster holding the database. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    clusterId: String|formae.Resolvable

    /// Database to enable the extension in. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    databaseName: String|formae.Resolvable

    /// Extension name, e.g. "citext", "postgis". Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    name: String

    /// Schema to install into. Defaults to the database's default schema.
    @formae.FieldHint { createOnly = true; hasProviderDefault = true }
    schema: String?

    /// Create the schema first if it does not exist.
    ///
    /// Write-only: it is an instruction for the create call, not a property of
    /// the extension, and the API never reports it back.
    @formae.FieldHint { createOnly = true; writeOnly = true }
    createSchema: Boolean?

    /// Installed version. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    version: String?

    /// Whether this is a system extension that cannot be disabled. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    system: Boolean?
}

// =============================================================================
// FLY::Postgres::Backup
// =============================================================================

/// A backup of a Managed Postgres cluster.
/// Native id is `{clusterId}/{id}`.
///
/// READ THIS FIRST — a backup is closer to an event than to infrastructure:
///
/// - Fly exposes no delete endpoint. `formae destroy` reports success and the
///   backup remains until it expires under the cluster's retention policy.
/// - The id is server-assigned, so a forma cannot name one. Re-applying after
///   a destroy takes a *new* backup rather than reconciling to the existing
///   one.
///
/// It is modelled because some pipelines want "take a backup at apply time".
/// For scheduled backups, use the cluster's retention policy instead.
// Not extractable, for the same reason as VolumeSnapshot: the backup id is
// server-assigned, so applying an extracted backup takes a new one instead of
// adopting the existing one.
@formae.ResourceHint {
    type = "FLY::Postgres::Backup"
    identifier = "$.id"
    discoverable = true
    extractable = false
}
class Backup extends formae.Resource {
    fixed hidden type: String = "FLY::Postgres::Backup"

    /// Cluster to back up. Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    clusterId: String|formae.Resolvable

    /// Backup type: "full", "incr" or "diff". Immutable.
    @formae.FieldHint { createOnly = true; requiredOnCreate = true }
    backupType: String

    /// Backup id, assigned by Fly. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    id: String?

    /// Backup status. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    status: String?

    /// Size in bytes. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    sizeBytes: Int?

    /// RFC 3339 start timestamp. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    startedAt: String?

    /// RFC 3339 finish timestamp. Output only.
    @formae.FieldHint { hasProviderDefault = true }
    finishedAt: String?
}
